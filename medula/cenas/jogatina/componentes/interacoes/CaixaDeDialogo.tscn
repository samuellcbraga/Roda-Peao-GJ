[gd_scene format=3 uid="uid://c5788gjidkqwf"]

[sub_resource type="GDScript" id="GDScript_86cne"]
resource_name = "caixaDeDialogo"
script/source = "extends Control
@onready var nome_char: Label = $DialogBox/nameTag/nomeChar
@onready var texto_do_diálogo: RichTextLabel = $DialogBox/PanelContainer/MarginContainer/textoDoDiálogo
@onready var sprite_char: TextureRect = $spriteChar
@onready var caixa: Control = $DialogBox
@onready var opcoes: VBoxContainer = $DialogBox/opcoes
var esperandoEscolha := false
signal escolhaFeita(id: String)
var falas: Array = []
var conversas: Dictionary = {}
var indice := 0 
var tween: Tween
signal final_do_dialogo
# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	hide()

func iniciarConversa(personagem: String) -> void:
	if not falas.is_empty():
		return
	if not atlas.personagens.has(personagem):
		push_warning(\"Personagem não existe no atlas: \" + personagem)
		return
	var dados: Dictionary = atlas.personagens[personagem]
	conversas = dados['conversas']
	if not conversas.has('inicio'):
		push_warning(personagem + \" não tem a conversa 'inicio' no atlas\")
		return
	nome_char.text = dados['nome']
	sprite_char.texture = dados.get('retrato')
	falas = conversas['inicio']
	indice = 0
	_mostrarFalasAtual()
	show()
	_pop_in()

func _input(event: InputEvent) -> void:
	if not visible:
		return
	if esperandoEscolha:
		return
	if tween and tween.is_running():
		return
	var clicou: bool = event is InputEventMouseButton and event.pressed and event.button_index == MOUSE_BUTTON_LEFT
	if clicou or event.is_action_pressed(\"ui_accept\"):
		get_viewport().set_input_as_handled()
		avancar()
func avancar() -> void:
	indice += 1
	if indice >= falas.size():
		terminar()
	else:
		_mostrarFalasAtual()


func limparOpcoes() -> void:
	for filho in opcoes.get_children():
		filho.queue_free()
	opcoes.hide()
	
func onOpcaoEscolhida(i: int) -> void:
	var opcao: Dictionary = falas[indice]['opcoes'][i]
	limparOpcoes()
	esperandoEscolha = false
	atlas.registrarEscolha(opcao.get('id', ''))
	escolhaFeita.emit(opcao.get('id', ''))
	var proxima: String = opcao.get('vai_para', '')
	if proxima == '':
		terminar()
	elif not conversas.has(proxima):
		push_warning(\"Conversa não existe: \" + proxima)
		terminar()
	else:
		falas = conversas[proxima]
		indice = 0
		_mostrarFalasAtual()

func mostrarOpcoes(lista: Array) -> void:
	limparOpcoes()
	var primeiro: Button = null
	for i in lista.size():
		var botao := Button.new()
		botao.text = lista[i]['texto']
		botao.pressed.connect(onOpcaoEscolhida.bind(i))
		opcoes.add_child(botao)
		if primeiro == null:
			primeiro = botao
	opcoes.show()
	esperandoEscolha = true
	primeiro.grab_focus()

func _mostrarFalasAtual() -> void:
	var fala: Dictionary = falas[indice]
	texto_do_diálogo.text = fala['texto']
	var lista: Array = fala.get('opcoes', [])
	if not lista.is_empty():
		mostrarOpcoes(lista)
func terminar() -> void:
	falas = []
	await _pop_out()
	hide()
	final_do_dialogo.emit()

func _pop_in() -> void:                                           
	caixa.pivot_offset = caixa.size / 2
	caixa.scale = Vector2(0.8, 0.8)
	caixa.modulate.a = 0.0
	if tween: tween.kill()
	tween = create_tween().set_parallel()
	tween.tween_property(caixa, \"scale\", Vector2.ONE, 0.25).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
	tween.tween_property(caixa, \"modulate:a\", 1.0, 0.15)
func _pop_out() -> void:                                          # NEW
	if tween: tween.kill()
	tween = create_tween().set_parallel()
	tween.tween_property(caixa, \"scale\", Vector2(0.8, 0.8), 0.15).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_IN)
	tween.tween_property(caixa, \"modulate:a\", 0.0, 0.15)
	await tween.finished
	
"

